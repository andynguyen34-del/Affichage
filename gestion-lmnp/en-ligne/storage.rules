rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function connecte() { return request.auth != null; }
    function rolesExiste() {
      return firestore.exists(/databases/(default)/documents/systeme/roles);
    }
    function estGerant() {
      return connecte() && (
        !rolesExiste()
        || request.auth.token.email in firestore.get(/databases/(default)/documents/systeme/roles).data.admins
      );
    }

    // Documents publiés pour un colocataire : lecture par lui seul (et les
    // gérants), écriture par les gérants.
    match /portail/{email}/{reste=**} {
      allow read: if estGerant() || (connecte() && request.auth.token.email.lower() == email);
      allow write: if estGerant();
    }

    // Tout le reste (documents, états des lieux, corbeille…) : gérants.
    match /{tout=**} {
      allow read, write: if estGerant();
    }
  }
}
