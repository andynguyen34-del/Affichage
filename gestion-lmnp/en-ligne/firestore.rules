rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Accès réservé aux comptes créés à la main dans la console Firebase.
    // L'inscription libre est désactivée dans Authentication > Paramètres,
    // donc « connecté » signifie « Andy ou Karine ».
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
