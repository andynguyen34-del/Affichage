# ---------------------------------------------------------------------------
# Configuration de l'application Affichage Usine
# Copier ce fichier en « .env » puis adapter les valeurs.
# ---------------------------------------------------------------------------

# Port d'ecoute du serveur (les ecrans ouvriront http://<ip-du-serveur>:8080/)
PORT=8080

# Dossier de stockage de la base SQLite (monte en volume dans Docker)
DATA_DIR=./data

# Racine autorisee pour la lecture des fichiers Excel.
# Dans Docker, le partage reseau est monte sur /partage : ne pas changer.
# Hors Docker (Windows), mettre par exemple //serveur/qualite ou D:\Partage
SOURCE_ROOT=/partage

# Mot de passe du compte administrateur cree au premier demarrage.
# A changer immediatement apres la premiere connexion via l'interface.
ADMIN_PASSWORD=admin

# Secret utilise pour signer les cookies de session.
# Generer une valeur aleatoire : openssl rand -hex 32
SESSION_SECRET=changez-moi-avec-une-valeur-aleatoire

# Intervalle du planificateur en secondes (frequence a laquelle on verifie
# si une source doit etre reimportee). 60 convient dans la quasi-totalite des cas.
SCHEDULER_TICK_SECONDS=60

# Fuseau horaire utilise pour l'horloge et les filtres de dates
TZ=Europe/Paris

# ---------------------------------------------------------------------------
# Montage du partage reseau (utilise par docker-compose.yml)
# ---------------------------------------------------------------------------
# Adresse UNC du partage sans les antislashs, ex : serveur-fichiers/Qualite/Indicateurs
SMB_SHARE=serveur-fichiers/Public/Indicateurs
SMB_USER=lecture_indicateurs
SMB_PASSWORD=
SMB_DOMAIN=WORKGROUP
